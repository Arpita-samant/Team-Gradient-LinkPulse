# ===================================================================
# LinkPulse Backend Environment Configuration
# ===================================================================

# Port to run the server on (Render, Railway, or VPS assigns this automatically)
PORT=5000

# Environment mode: 'development' or 'production'
NODE_ENV=development

# Secret key used for signing JWT authentication tokens (use a strong random string)
JWT_SECRET=linkpulse_jwt_secret_key_hackathon_2026

# The public base URL for short links (e.g., https://your-domain.com or https://api.yourdomain.com)
BASE_URL=http://localhost:5000

# The URL of your deployed frontend (e.g., https://linkpulse.vercel.app)
CLIENT_URL=http://localhost:5173

# Allowed CORS origins (comma-separated for multiple origins, or * for all)
CORS_ORIGIN=http://localhost:5173,https://*.vercel.app

# MongoDB Atlas connection string
# Format: mongodb+srv://<username>:<password>@cluster0.mongodb.net/linkpulse?retryWrites=true&w=majority
# (If omitted or left with <password>, LinkPulse automatically uses its high-fidelity persistent local store)
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/linkpulse?retryWrites=true&w=majority
